NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://www.tazarzitbio.com
# Google Search Console HTML meta verification (optional; domain DNS TXT preferred)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# =============================================================================
# Admin login (/admin) — SERVER RUNTIME ONLY
# In EasyPanel: Project → Environment (runtime) — NOT "Build Arguments"
# After changing any of these, redeploy / restart the service.
# Never use NEXT_PUBLIC_* for secrets.
# =============================================================================

# REQUIRED (choose ONE):
# Plain password you type at /admin/login
ADMIN_PASSWORD=YourStrongPassword
# Or a hex SHA-256 of that password (hash mode takes priority when set):
# ADMIN_PASSWORD_SHA256=

# Strongly recommended — long random secret for signing the session cookie
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Optional overrides:
# ADMIN_COOKIE_VALUE=          # legacy alias for ADMIN_SESSION_SECRET
# ADMIN_COOKIE_SECURE=true     # force Secure cookie (default on in production)

# Marketing & analytics
# Meta Pixel (public dataset ID). EasyPanel already has META_PIXEL_ID — preferred.
# Official TazarzitBio Pixel: 1371182047797117 (used as code fallback if env empty).
META_PIXEL_ID=1371182047797117
# Optional client mirror of the public Pixel ID (not required when META_PIXEL_ID is set
# and /api/tracking is used). Do NOT put the CAPI token in NEXT_PUBLIC_*.
NEXT_PUBLIC_META_PIXEL_ID=1371182047797117

# Server-only Meta Conversions API token — NEVER use NEXT_PUBLIC_ for this
META_CAPI_ACCESS_TOKEN=
# Optional: Meta Events Manager "Test Events" code
# META_TEST_EVENT_CODE=

NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads tag from Ads → Data manager → Google tag (e.g. AW-18456371320)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional conversion label for Purchase: send_to AW-xxx/LABEL
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Orders export (Google Apps Script webhook)
GOOGLE_SHEETS_WEBHOOK_URL=

# Instant order alerts (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Elite Delivery (server-only — NEVER NEXT_PUBLIC_*)
# Token from Elite → Configuration API. Store ID from GET /v1.0/stores/{token}.
ELITE_DELIVERY_API_TOKEN=
ELITE_DELIVERY_STORE_ID=
ELITE_DELIVERY_BASE_URL=https://elitedelivery.ma
# Random secret used in webhook URL path:
#   https://YOUR_DOMAIN/api/webhooks/elite-delivery/<ELITE_DELIVERY_WEBHOOK_SECRET>
ELITE_DELIVERY_WEBHOOK_SECRET=
