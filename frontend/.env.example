NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Admin login (/admin) — SERVER RUNTIME ONLY
# In EasyPanel: Project → Environment (runtime) — NOT "Build Arguments"
# After changing any of these, redeploy / restart the service.
# Never use NEXT_PUBLIC_* for secrets.
# =============================================================================

# REQUIRED (choose ONE):
# Plain password you type at /admin/login
ADMIN_PASSWORD=YourStrongPassword
# Or a hex SHA-256 of that password (hash mode takes priority when set):
# ADMIN_PASSWORD_SHA256=

# Strongly recommended — long random secret for signing the session cookie
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Optional overrides:
# ADMIN_COOKIE_VALUE=          # legacy alias for ADMIN_SESSION_SECRET
# ADMIN_COOKIE_SECURE=true     # force Secure cookie (default on in production)

# Marketing & analytics (optional — can also be set in Admin → Tracking)
# Meta Pixel ID is public (dataset). Prefer META_PIXEL_ID at runtime (EasyPanel).
META_PIXEL_ID=
# Server-only Meta Conversions API token — NEVER use NEXT_PUBLIC_ for this
META_CAPI_ACCESS_TOKEN=
# Optional: Meta Events Manager "Test Events" code for verification
# META_TEST_EVENT_CODE=

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Orders export (Google Apps Script webhook)
GOOGLE_SHEETS_WEBHOOK_URL=

# Instant order alerts (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
