NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin) — server-only. Never use NEXT_PUBLIC_* for secrets.
# Required (pick ONE):
#   ADMIN_PASSWORD          = plain password typed at /admin/login
#   ADMIN_PASSWORD_SHA256   = hex SHA-256 of that password (preferred if your host stores env in plaintext)
ADMIN_PASSWORD=YourStrongPassword
# ADMIN_PASSWORD_SHA256=

# Strongly recommended: separate secret for signing the admin session cookie
# (falls back to ADMIN_PASSWORD if unset)
ADMIN_SESSION_SECRET=replace-with-long-random-secret
# Legacy optional alias for session signing secret:
# ADMIN_COOKIE_VALUE=

# Marketing & analytics (optional — can also be set in Admin → Tracking)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Orders export (Google Apps Script webhook)
GOOGLE_SHEETS_WEBHOOK_URL=

# Instant order alerts (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
