NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin) — required for sign-in; change to rotate access
ADMIN_PASSWORD=YourStrongPassword
# Optional: separate cookie secret (defaults to ADMIN_PASSWORD)
# ADMIN_COOKIE_VALUE=

# Marketing & analytics (optional — can also be set in Admin → Tracking)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Orders export (Google Apps Script webhook)
GOOGLE_SHEETS_WEBHOOK_URL=
